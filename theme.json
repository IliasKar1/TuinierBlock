{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "forest",      "name": "Forest Green",  "color": "#1F3D2B" },
        { "slug": "moss",        "name": "Moss",          "color": "#3F6B4A" },
        { "slug": "fern",        "name": "Fern",          "color": "#8DAE7E" },
        { "slug": "cream",       "name": "Cream",         "color": "#F4EFE2" },
        { "slug": "terracotta",  "name": "Terracotta",    "color": "#C0633D" },
        { "slug": "mustard",     "name": "Mustard",       "color": "#D9A441" },
        { "slug": "ink",         "name": "Ink",           "color": "#1A1A1A" },
        { "slug": "paper",       "name": "Paper",         "color": "#FBF8F1" }
      ],
      "gradients": [
        {
          "slug": "garden-dawn",
          "name": "Garden Dawn",
          "gradient": "linear-gradient(180deg, #F4EFE2 0%, #FBF8F1 60%, #D9A441 100%)"
        },
        {
          "slug": "forest-depth",
          "name": "Forest Depth",
          "gradient": "linear-gradient(135deg, #3F6B4A 0%, #1F3D2B 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "fraunces",
          "name": "Fraunces",
          "fontFamily": "Fraunces, 'Cormorant Garamond', Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontWeight": "400 900",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [ "https://fonts.gstatic.com/s/fraunces/v37/6NUh8FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk.woff2" ]
            }
          ]
        },
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "Manrope, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "src": [ "https://fonts.gstatic.com/s/manrope/v15/xn7gYHE41ni1AdIRggexSg.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "sm",  "name": "Small",   "size": "0.875rem", "fluid": false },
        { "slug": "md",  "name": "Medium",  "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
        { "slug": "lg",  "name": "Large",   "size": "1.25rem",  "fluid": { "min": "1.125rem", "max": "1.375rem" } },
        { "slug": "xl",  "name": "X-Large", "size": "1.75rem",  "fluid": { "min": "1.375rem", "max": "2rem" } },
        { "slug": "2xl", "name": "2X-Large","size": "2.5rem",   "fluid": { "min": "2rem", "max": "3rem" } },
        { "slug": "3xl", "name": "3X-Large","size": "3.5rem",   "fluid": { "min": "2.5rem", "max": "4.5rem" } },
        { "slug": "4xl", "name": "Display", "size": "5rem",     "fluid": { "min": "3rem", "max": "6rem" } }
      ]
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vh", "vw" ],
      "spacingScale": { "operator": "*", "increment": 1.5, "steps": 7, "mediumStep": 1.5, "unit": "rem" }
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)"
      },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--forest)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)" } },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontSize": "var(--wp--preset--font-size--4xl)", "fontWeight": "500", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontSize": "var(--wp--preset--font-size--3xl)", "fontWeight": "500", "lineHeight": "1.1",  "letterSpacing": "-0.015em" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontSize": "var(--wp--preset--font-size--2xl)", "fontWeight": "500", "lineHeight": "1.15" } },
      "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontSize": "var(--wp--preset--font-size--xl)",  "fontWeight": "600", "lineHeight": "1.2" } },
      "link": { "color": { "text": "var(--wp--preset--color--terracotta)" }, "typography": { "textDecoration": "underline" }, ":hover": { "color": { "text": "var(--wp--preset--color--forest)" } } },
      "button": {
        "color": { "background": "var(--wp--preset--color--forest)", "text": "var(--wp--preset--color--cream)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontWeight": "600", "letterSpacing": "0.02em" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.9rem", "right": "1.75rem", "bottom": "0.9rem", "left": "1.75rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--terracotta)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header",     "title": "Header",     "area": "header" },
    { "name": "footer",     "title": "Footer",     "area": "footer" },
    { "name": "mini-cart",  "title": "Mini Cart",  "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "single-product", "title": "Productpagina (block theme pilot)", "postTypes": [ "product" ] }
  ]
}
